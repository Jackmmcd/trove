generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Fund {
  id        String    @id @default(cuid())
  cik       String    @unique
  name      String
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  holdings  Holding[]

  @@index([cik])
}

model Holding {
  id            String   @id @default(cuid())
  fundId        String
  ticker        String
  shares        Float
  value         Float
  weight        Float
  quarter       String
  filingDate    DateTime
  createdAt     DateTime @default(now())

  fund          Fund     @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@index([fundId])
  @@index([ticker])
  @@index([quarter])
  @@unique([fundId, ticker, quarter])
}

model PortfolioPosition {
  id            String   @id @default(cuid())
  ticker        String   @unique
  shares        Float
  averagePrice  Float
  currentPrice  Float
  totalValue    Float
  updatedAt     DateTime @default(now())

  @@index([ticker])
}

model BasketPurchase {
  id        String   @id @default(cuid())
  fundId    String
  fundName  String
  budget    Float
  placedAt  DateTime @default(now())
  orders    Json     // Array of { ticker, shares, price, status }

  @@index([fundId])
  @@index([placedAt])
}

model StockAnalysis {
  ticker    String   @id
  summary   String
  bullCase  String   // JSON array
  bearCase  String   // JSON array
  createdAt DateTime @default(now())
}

model DailyDigest {
  date      String   @id  // YYYY-MM-DD
  digest    String
  createdAt DateTime @default(now())
}

model FundThesis {
  fundId    String   @id
  thesis    String
  quarter   String
  createdAt DateTime @default(now())
}

model RebalanceEvent {
  id            String    @id @default(cuid())
  eventType     String
  targetWeights Json
  currentWeights Json
  trades        Json
  executed      Boolean   @default(false)
  executedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([createdAt])
}
